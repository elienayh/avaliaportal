{
  "name": "SchoolClass",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "unique": true,
      "description": "Nome/t\u00edtulo da turma (ex.: 8\u00ba Ano A, 1\u00ba Ano EM B)."
    },
    "level": {
      "type": "string",
      "enum": [
        "Ensino Fundamental",
        "Ensino M\u00e9dio"
      ],
      "description": "N\u00edvel de ensino da turma, usado para liberar per\u00edodos de marca\u00e7\u00e3o distintos."
    }
  },
  "required": [
    "name",
    "level"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}